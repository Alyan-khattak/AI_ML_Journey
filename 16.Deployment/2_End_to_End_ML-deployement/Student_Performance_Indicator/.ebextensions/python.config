# .ebextensions/python.config
option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: application:application


# ═══════════════════════════════════════════════════════════════════
# .ebextensions/python.config
# ═══════════════════════════════════════════════════════════════════
# EB (Elastic Beanstalk) ko batata hai ki Flask app kaise run karni hai.
# .ebextensions/ folder = EB ka configuration folder
# python.config      = Python-specific settings
#
# ── SETUP PROCESS (step by step) ──────────────────────────────────
#
# STEP 1 — AWS Account
#   aws.amazon.com pe account banao
#   IAM → user banao → AdministratorAccess policy attach karo
#   Access Key + Secret Key save karo
#
# STEP 2 — AWS CLI install karo (Arch Linux)
#   sudo pacman -S aws-cli
#   aws configure
#   → AWS Access Key ID     : <tumhara key>
#   → AWS Secret Access Key : <tumhara secret>
#   → Default region        : us-east-1  (ya jo chahiye)
#   → Output format         : json
#
# STEP 3 — Project structure ready karo
#   Student_Performance_Indicator/
#   ├── application.py         ← app.py ka rename (EB "application" dhundhta hai)
#   ├── requirements.txt       ← sab dependencies
#   ├── .ebextensions/
#   │   └── python.config      ← YEH FILE
#   ├── artifacts/
#   │   ├── model.pkl          ← IMP: zip mein hona chahiye
#   │   └── preprocessor.pkl   ← IMP: zip mein hona chahiye
#   ├── src/
#   └── templates/
#
# STEP 4 — application.py banao
#   cp app.py application.py
#   EB internally "application:application" dhundhta hai
#   matlab: application.py file mein "application" naam ka Flask object
#   tumhara code: application = Flask(__name__)  ← already sahi hai ✅
#
# STEP 5 — zip banao (venv aur git exclude karo)
#   cd /home/aizen/ML_Projects/Student_Performance_Indicator
#   zip -r app.zip . \
#     --exclude "*.git*" \
#     --exclude "venv/*" \
#     --exclude "__pycache__/*" \
#     --exclude "*.pyc" \
#     --exclude "logs/*" \
#     --exclude "catboost_info/*" \
#     --exclude "Notebook/*"
#
# STEP 6 — AWS Console pe deploy
#   aws.amazon.com → Elastic Beanstalk → Create Application
#   ├── Application name : student-performance-indicator
#   ├── Platform         : Python
#   ├── Platform branch  : Python 3.11 (ya latest)
#   ├── Upload code      : app.zip upload karo
#   └── Create environment → EB sab kuch khud banata hai
#       (EC2 instance, load balancer, security groups)
#
# STEP 7 — Wait (~5 min)
#   EB environment "Health: Ok" dikhayega
#   URL milega: http://student-xyz.us-east-1.elasticbeanstalk.com
#
# STEP 8 — Agar error aaye
#   EB Console → Logs → Request Logs → Last 100 Lines
#   Ya: eb logs  (agar EB CLI install hai)
#
# ── COMMON ERRORS ─────────────────────────────────────────────────
# ModuleNotFoundError  → requirements.txt mein package missing hai
# 502 Bad Gateway      → WSGIPath galat hai — neeche check karo
# model not found      → artifacts/ zip mein nahi thi
# ──────────────────────────────────────────────────────────────────

option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: application:application
    # WSGIPath = "filename:flask_object_name"
    # application  ← application.py file
    # :application ← us file mein Flask object ka naam
    #
    # tumhara application.py:
    #   application = Flask(__name__)  ← yahi object point ho raha hai
    #
    # agar app.py use karo aur app = Flask(__name__) ho toh:
    #   WSGIPath: app:app
